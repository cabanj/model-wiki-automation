# Line endings. The VPS checks this repo out on Linux and runs the shell
# scripts and unit files directly, so CRLF is not cosmetic: a CRLF in a
# systemd unit or a #! line produces a real failure, not a warning.
# core.autocrlf=true on the Windows laptop would otherwise convert these back.

* text=auto eol=lf

*.py   text eol=lf
*.sh   text eol=lf
*.conf text eol=lf
*.service text eol=lf
*.md   text eol=lf
*.xml  text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.json text eol=lf

# Local Windows tool state that must never be normalised.
*.png  binary
*.jpg  binary
*.ico  binary
